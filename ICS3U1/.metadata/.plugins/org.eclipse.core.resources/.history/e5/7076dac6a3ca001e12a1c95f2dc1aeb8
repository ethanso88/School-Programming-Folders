//Description: A program to calculate the sum, product, difference and quotient of 2 numbers
//Major Skills: variables, taking input, printing output

public class Calculate {
	
	public static void main(String[] args) {
		
		//setup input variable with scanner
		Scanner input = new Scanner(System.in);
		
		//declare variables
		int num1;
		int num2;
		int sum;
		int product;
		int difference; 
		int quotient; 
		
		//take the input
		System.out.print("Please enter number 1 to be calculated: "); //prompt for the input
		num1 = input.nextInt();
		num2 = input.nextInt();
		
		//calculate the sum, product, difference and quotient
		sum = num1 + num2;
		product = num1 * num2;
		difference = num1 - num2;
		quotient = num1 / num2;
		
		//output
		System.out.printf("The sum is: %d \n", sum);
		System.out.printf("The product is: %d \n", product);
		System.out.printf("The difference is: %d \n", difference);
		System.out.printf("The quotient is: %d \n", quotient);
		
	} //end of main method

} //end of class
